<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UchebnayPracticaTestirovanie.Views.LoginWindow"
        Title="Вход"
        Width="460"
        Height="460"
        WindowStartupLocation="CenterScreen"
        CanResize="False">
	<StackPanel Width="340" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
		<TextBlock Text="Инфотех — заявки на ремонт" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/>
		<TextBox x:Name="LoginBox" PlaceholderText="Логин" KeyDown="Input_KeyDown"/>
		<TextBox x:Name="PasswordBox" PlaceholderText="Пароль" PasswordChar="•" KeyDown="Input_KeyDown"/>
		<Button Content="Войти" Click="Login_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
		<TextBlock x:Name="ErrorText" Foreground="#B00020" TextWrapping="Wrap"/>
		<TextBlock Opacity="0.75" TextWrapping="Wrap"
		           Text="login1 / pass1 — менеджер&#x0a;login2 / pass2 — техник&#x0a;login4 / pass4 — оператор&#x0a;login7 / pass7 — заказчик"/>
	</StackPanel>
</Window>
